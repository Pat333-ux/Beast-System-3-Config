{
  "encryption": {
    "algorithm": "AES-256",
    "keyRotationDays": 90,
    "enableAtRestEncryption": true,
    "enableInTransitEncryption": true
  },

  "hashing": {
    "algorithm": "SHA-512",
    "passwordSaltBytes": 32,
    "pepperEnabled": true
  },

  "tokens": {
    "format": "JWT",
    "issuer": "beast-system-3",
    "audience": "nwo-governance-network",
    "accessTokenMinutes": 30,
    "refreshTokenDays": 14,
    "signingKeyType": "RSA-4096"
  },

  "authentication": {
    "multiFactorAuth": true,
    "allowedMethods": [
      "totp",
      "sms",
      "email"
    ],
    "sessionTimeoutMinutes": 30,
    "maxFailedAttempts": 5,
    "lockoutMinutes": 15
  },

  "authorization": {
    "permissionsMapFile": "permissions-map.json",
    "defaultRole": "citizen",
    "adminOverrideRole": "Chief Executive Officer"
  },

  "network": {
    "allowedOrigins": ["*"],
    "rateLimitPerMinute": 1200,
    "burstLimit": 200,
    "ipWhitelist": [],
    "ipBlacklist": []
  },

  "audit": {
    "logSecurityEvents": true,
    "logAuthenticationEvents": true,
    "logAuthorizationEvents": true,
    "retainDays": 365,
    "federalExportEnabled": true,
    "chainAnchoring": true
  },

  "integrity": {
    "configChecksum": "sha512",
    "autoVerifyOnStartup": true,
    "tamperProtection": true
  },

  "secrets": {
    "useExternalVault": true,
    "vaultProvider": "nwo-secure-vault",
    "rotationPolicyDays": 60
  },

  "metadata": {
    "createdBy": "Pat Tarwater Jr, Chief Executive Officer",
    "contactEmail": "illuminatedson49@gmail.com",
    "lastUpdated": "2026-05-06T10:11:00Z"
  }
}
